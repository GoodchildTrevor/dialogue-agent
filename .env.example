APP_NAME=dialogue-bot
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

OLLAMA_BASE_URL=http://host.docker.internal:11434
ROUTER_MODEL=llama3.1:8b
REASONING_MODEL=qwen2.5-coder:14b
EMBEDDING_MODEL=nomic-embed-text

POSTGRES_DB=dialogue_bot
POSTGRES_USER=dialogue_bot
POSTGRES_PASSWORD=dialogue_bot
POSTGRES_URL=postgresql+asyncpg://dialogue_bot:dialogue_bot@postgres:5432/dialogue_bot

# Local volume mount path for uploaded files (must match docker-compose volumes mount)
STORAGE_LOCAL_PATH=/app/storage

CHUNKER_SERVICE_URL=http://chunker_service:8081
PG_INGESTER_URL=http://pg_ingester:8082
DOCUMENT_SEARCHER_URL=http://document_searcher:8091
FILE_VIEWER_URL=http://file_viewer:8092
WEB_SEARCHER_URL=http://web_searcher:8093
IMAGE_GENERATOR_URL=http://image_generator:8094
FILE_CONVERTER_URL=http://file_converter:8095

MAX_TOOL_RETRIES=3
HTTP_TIMEOUT_SECONDS=20
TOOL_REQUEST_TIMEOUT_SECONDS=45
HTTP_MAX_CONNECTIONS=100
HISTORY_SEARCH_LIMIT=5
