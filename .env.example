APP_NAME=dialogue-bot
API_V1_PREFIX=/api/v1
API_KEY=REPLACE_WITH_STRONG_API_KEY
LOG_LEVEL=INFO

# LiteLLM proxy base URL
LLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=your master key
# Model aliases must match model_name entries in litellm_config.yaml
ROUTER_MODEL=router-model
REASONING_MODEL=reasoning-model

# Primary MCP tool server (dialogue-agent-mcp) — always loaded
MCP_SERVER_URL=http://dialogue-agent-mcp:8000/mcp
# Shared Bearer token — must match MCP_AUTH_TOKEN in dialogue-agent-mcp
MCP_AUTH_TOKEN=REPLACE_WITH_STRONG_PASSWORD

# Additional MCP servers (JSON array). Each entry must have "url";
# "token" and "name" are optional. The primary server above is always
# prepended automatically — do NOT repeat it here.
# Example with two extra servers:
# MCP_SERVERS=[{"url":"http://oracle-mcp:3000/mcp","token":"secret","name":"oracle"},{"url":"http://another-mcp:4000/mcp","name":"another"}]
MCP_SERVERS=[]

# Legacy file converter MCP server (optional — prefer MCP_SERVERS for new servers)
FILE_CONVERTER_MCP_URL=http://file-converter-mcp:8000/mcp
FILE_CONVERTER_AUTH_TOKEN=

QDRANT_INGESTER_URL=http://qdrant_ingester:8000/ingest
QDRANT_INGESTER_API=

POSTGRES_DB=dialogue_bot
POSTGRES_USER=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_PASSWORD=dialogue_bot
POSTGRES_URL=postgresql+asyncpg://dialogue_bot:dialogue_bot@postgres:5432/dialogue_bot

# Local volume mount path for uploaded files (must match docker-compose volumes mount)
STORAGE_LOCAL_PATH=/app/storage

CHUNKER_SERVICE_URL=http://chunker_service:8081

# In-process embedding via fastembed
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_BATCH_SIZE=32
EMBEDDING_INSERT_BATCH_SIZE=64

MAX_TOOL_RETRIES=3
HTTP_TIMEOUT_SECONDS=20
TOOL_REQUEST_TIMEOUT_SECONDS=45
HTTP_MAX_CONNECTIONS=100
HISTORY_SEARCH_LIMIT=5

# If document token count is <= this value, raw text is returned instead of
# ingesting into Qdrant. Omit or set to 0 to always ingest.
INLINE_THRESHOLD=1000
